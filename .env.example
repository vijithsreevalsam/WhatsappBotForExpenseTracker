# ==========================================
# WHATSAPP EXPENSE BOT CONFIGURATION
# ==========================================

# 1. GROUP FILTERING (STRICT SECURITY)
# Set the EXACT name of your WhatsApp group chat (e.g., "Monthly Expenses")
# The bot will IGNORE all other groups and personal chats!
TARGET_GROUP_NAME=Monthly Expenses

# 2. GEMINI AI API KEY
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Set the Gemini model to use (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash


# 3. GOOGLE SHEETS INTEGRATION
# ID from your spreadsheet URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# 4. BOT PERSONALIZATION & SENSITIVE DETAILS
OWNER_1_ID=your_owner_1_whatsapp_id_here
OWNER_1_PHONE=your_owner_1_phone_number_here
OWNER_1_NAME=Owner1

OWNER_2_ID=your_owner_2_whatsapp_id_here
OWNER_2_PHONE=your_owner_2_phone_number_here
OWNER_2_NAME=Owner2

